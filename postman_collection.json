{
  "info": {
    "name": "Distributed Webhook Dispatcher Engine",
    "_postman_id": "a983b745-f033-4f93-b413-5a02298bc671",
    "description": "Complete Postman collection for the Distributed Webhook Dispatcher Engine with built-in mock receivers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "jobId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Checks connectivity to API, PostgreSQL and Redis."
      }
    },
    {
      "name": "2. Dispatch to Mock OK (200 Success)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.jobId) {",
              "    pm.collectionVariables.set('jobId', json.jobId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"destinationUrl\": \"{{baseUrl}}/mock/ok\",\n  \"eventId\": \"evt_postman_{{$randomUUID}}\",\n  \"payload\": {\n    \"event\": \"payment.completed\",\n    \"amount\": 99.50,\n    \"currency\": \"USD\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/webhooks/dispatch",
          "host": ["{{baseUrl}}"],
          "path": ["api", "webhooks", "dispatch"]
        },
        "description": "Dispatches webhook to /mock/ok. Responds immediately with 202 Accepted."
      }
    },
    {
      "name": "3. Dispatch to Mock Fail (500 Retries)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"destinationUrl\": \"{{baseUrl}}/mock/fail\",\n  \"eventId\": \"evt_fail_{{$randomUUID}}\",\n  \"payload\": {\n    \"event\": \"test.failure\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/webhooks/dispatch",
          "host": ["{{baseUrl}}"],
          "path": ["api", "webhooks", "dispatch"]
        },
        "description": "Dispatches to /mock/fail. Worker will retry 3 times with exponential backoff (2s, 4s, 8s)."
      }
    },
    {
      "name": "4. Dispatch to Mock Flaky (Succeeds on Attempt 3)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"destinationUrl\": \"{{baseUrl}}/mock/flaky?key=pm_{{$randomUUID}}\",\n  \"eventId\": \"evt_flaky_{{$randomUUID}}\",\n  \"payload\": {\n    \"event\": \"test.flaky\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/webhooks/dispatch",
          "host": ["{{baseUrl}}"],
          "path": ["api", "webhooks", "dispatch"]
        },
        "description": "Dispatches to /mock/flaky. Fails twice with 500, then succeeds on attempt 3."
      }
    },
    {
      "name": "5. Dispatch to Mock Slow (Async 10s Non-blocking)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"destinationUrl\": \"{{baseUrl}}/mock/slow\",\n  \"eventId\": \"evt_slow_{{$randomUUID}}\",\n  \"payload\": {\n    \"event\": \"test.slow\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/webhooks/dispatch",
          "host": ["{{baseUrl}}"],
          "path": ["api", "webhooks", "dispatch"]
        },
        "description": "Dispatches to /mock/slow. Ingestion API returns in < 30ms despite downstream 10s latency."
      }
    },
    {
      "name": "6. Dispatch to Mock Rate Limit (429 Retry-After)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"destinationUrl\": \"{{baseUrl}}/mock/ratelimit\",\n  \"eventId\": \"evt_ratelimit_{{$randomUUID}}\",\n  \"payload\": {\n    \"event\": \"test.ratelimit\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/webhooks/dispatch",
          "host": ["{{baseUrl}}"],
          "path": ["api", "webhooks", "dispatch"]
        },
        "description": "Dispatches to /mock/ratelimit. Receives 429 and honors Retry-After header."
      }
    },
    {
      "name": "7. Get Webhook Job Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/webhooks/{{jobId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "webhooks", "{{jobId}}"]
        },
        "description": "Retrieves the current execution status, attempt count and timestamps."
      }
    },
    {
      "name": "8. Get Delivery Attempts History",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/webhooks/{{jobId}}/attempts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "webhooks", "{{jobId}}", "attempts"]
        },
        "description": "Retrieves chronological attempt history with duration, status and error messages."
      }
    },
    {
      "name": "9. List Recent Webhooks",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/webhooks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "webhooks"]
        },
        "description": "Retrieves the latest 20 webhook events."
      }
    }
  ]
}
