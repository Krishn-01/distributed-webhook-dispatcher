# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Single-Process Deployment
# When true, starts the BullMQ background worker inside the API server process
# (default: true in production, false in development/test)
RUN_WORKER_IN_PROCESS=false

# CORS Configuration (comma-separated origins or *)
CORS_ORIGIN=*

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5434/webhook_dispatcher?schema=public"

# Redis Configuration (BullMQ Queue & Per-Domain Sliding-Window Rate Limiter)
REDIS_URL="redis://localhost:6381"
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

# Outbound Rate Limiting (per destination domain via Redis Lua sliding-window)
# Default: 10 requests per 1000ms (1 second) per destination domain
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=1000

# Worker & Outbound HTTP Delivery Configuration
WORKER_CONCURRENCY=5
DELIVERY_TIMEOUT_MS=10000
MAX_RETRIES=3

# SSRF Security & Mock Receiver Configuration
# Keep ENABLE_SSRF_PROTECTION=true in all environments
ENABLE_SSRF_PROTECTION=true

# Allow private/loopback destination hosts (true in local/test development only; NEVER true in production render.yaml)
ALLOW_PRIVATE_HOSTS=false

# Production Self URL (e.g. https://<app>.onrender.com)
# Allows the live demo on Render to dispatch webhooks to its own /mock endpoints without disabling SSRF
SELF_BASE_URL=
