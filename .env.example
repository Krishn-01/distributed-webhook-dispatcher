# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/webhook_dispatcher?schema=public"

# Redis Configuration (Queue & Distributed Rate Limiter)
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker Configuration
WORKER_CONCURRENCY=5

# Outbound HTTP Delivery Configuration
DELIVERY_TIMEOUT_MS=10000
MAX_RETRIES=3

# Destination Domain Rate Limiting (Outbound)
# Default: 10 requests per 1000ms (1 second) per destination domain
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=1000

# Security
ENABLE_SSRF_PROTECTION=true
